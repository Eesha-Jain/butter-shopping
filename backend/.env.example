# Optional. The proxy already reads repo-root `.env.local`.
# Prefer putting these keys there instead of creating backend/.env.

# Kroger / QFC API (https://developer.kroger.com/)
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=

# Supabase — required for persist (writing products, store_products, prices)
# Get service_role from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Or reuse EXPO_PUBLIC_SUPABASE_URL from .env.local
SUPABASE_SERVICE_ROLE_KEY=

# Verify before demo:
#   cd backend && npm start
#   curl http://127.0.0.1:3000/api/health
# Expect: { "qfc": true, "safeway": true, "persist": true }
