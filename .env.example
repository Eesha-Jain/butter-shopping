# Expo app (copy to .env.local)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional: override the price proxy URL in production builds (see src/api/config.js).
# EXPO_PUBLIC_BACKEND_URL=https://your-deployed-backend.com

# Optional: Visa Developer sandbox (VMORC). Without these, /api/visa/offers uses demo offers.
# VISA_USER_ID=
# VISA_PASSWORD=
# VISA_CERT_PATH=
# VISA_KEY_PATH=
