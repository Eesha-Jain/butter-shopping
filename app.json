{
  "expo": {
    "name": "Butter Shopping",
    "slug": "butter-shopping",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "buttershopping",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Used to transcribe your push-to-talk order.",
        "NSMicrophoneUsageDescription": "Butter uses your microphone so you can talk to your grocery shopping assistant.",
        "NSLocationWhenInUseUsageDescription": "We use your location to find the best deals and products near you.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bitcode": false,
      "bundleIdentifier": "com.pigggsteam.buttershopping"
    },
    "android": {
      "package": "com.pigggsteam.buttershopping",
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/icon.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/logo.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-sqlite",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-speech-recognition",
      "expo-audio",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "We use your location to find the best deals and products near you."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Butter uses your photos for your profile picture, shelf price reports, and recipe imports.",
          "cameraPermission": "Butter uses your camera for your profile picture, shelf price photos, and recipe imports.",
          "microphonePermission": false
        }
      ],
      "expo-document-picker",
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "8cbbf0fe-74d8-4193-bb99-de8d087843dd"
      }
    },
    "owner": "eeja"
  }
}
